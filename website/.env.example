# Instagram Basic Display long-lived access token
INSTAGRAM_ACCESS_TOKEN=

# Optional: profile link used for fallback boxes
PUBLIC_INSTAGRAM_PROFILE_URL=https://www.instagram.com/alleghenycompsci/

# Optional: comma-separated fallback post shortcodes used when Instagram API
# requests are rate-limited or blocked during static builds.
PUBLIC_INSTAGRAM_FALLBACK_POST_SHORTCODES=DNtekacwvkh,Dak5fz1FcBv,Dak4NMhlbhB,Dak14UZFeXw

# Google Calendar API key (required for event cards on calendar and news pages)
# Get one at https://console.cloud.google.com — enable the Google Calendar API
# Add this as a GitHub Actions secret named GOOGLE_CALENDAR_API_KEY for CI builds
GOOGLE_CALENDAR_API_KEY=
