---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/ui/TableOfContents.jsx';

const { frontmatter } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const mdxModules = import.meta.glob('../pages/community/news/*.mdx', { eager: true });
const latest = Object.values(mdxModules)
    .map((mod: any) => mod.frontmatter)
    .sort((a: any, b: any) => new Date(b.date).valueOf() - new Date(a.date).valueOf())[0];

const latestUpdate = latest ? {
    title: latest.title,
    date: new Date(latest.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    category: latest.category,
    href: `${base}community/news`,
} : null;

const relatedLinks = frontmatter?.relatedLinks ?? null;

const path = Astro.url.pathname;
const showApply = (path.includes('/about/') && !path.includes('/about/policies')) || path.includes('/plan/');

const sectionNavMap: Record<string, { label: string; href: string }[]> = {
    about: [
        { label: 'Our Purpose',  href: `${base}about/statement` },
        { label: 'Action Plan',  href: `${base}about/actionplan` },
        { label: 'Faculty',      href: `${base}about/faculty` },
        { label: 'Facilities',   href: `${base}about/facilities` },
        { label: 'Policies',     href: `${base}about/policies` },
    ],
    plan: [
        { label: 'Majors & Minors',   href: `${base}plan/degrees` },
        { label: 'My Path',           href: `${base}plan/mypath` },
        { label: 'Microcredentials',  href: `${base}plan/microcredentials` },
        { label: 'Course Bulletin',   href: `${base}plan/bulletin` },
    ],
    community: [
        { label: 'Calendar & News',        href: `${base}community/news` },
        { label: 'Technical Leaders',      href: `${base}community/tl` },
        { label: 'Technical Advisory Board', href: `${base}community/tab` },
        { label: 'Outreach',               href: `${base}community/outreach` },
    ],
    resources: [
        { label: 'Overview',    href: `${base}resources/overview` },
        { label: 'Data Gators', href: `${base}resources/data-gators` },
        { label: 'References',  href: `${base}resources/references` },
        { label: 'Laptops',     href: `${base}resources/laptops` },
    ],
    opportunities: [
        { label: 'Overview',       href: `${base}opportunities/overview` },
        { label: 'CMU 3-2 Programs', href: `${base}opportunities/cmu` },
    ],
};

const sectionLabels: Record<string, string> = {
    about: 'About',
    plan: 'Programs',
    community: 'Community',
    resources: 'Resources',
    opportunities: 'Opportunities',
};

const section = Object.keys(sectionNavMap).find(s => path.includes(`/${s}/`)) ?? null;
const sectionPages = section ? sectionNavMap[section] : null;
const sectionLabel = section ? sectionLabels[section] : null;
---

<BaseLayout pageTitle={frontmatter?.pageTitle ?? ''}>
    <div class="mdx-page">
        <div class="mdx-layout">
            <TableOfContents
                latestUpdate={latestUpdate}
                relatedLinks={relatedLinks}
                showApply={showApply}
                sectionPages={sectionPages}
                sectionLabel={sectionLabel}
                currentPath={path}
                client:idle
            />
            <div class="mdx-body">
                <slot />
            </div>
        </div>
    </div>
</BaseLayout>
