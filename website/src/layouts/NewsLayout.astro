---
import BaseLayout from './BaseLayout.astro';
import placeholderImg from '../assets/img/placeholder.jpg';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Format in UTC so a YYYY-MM-DD date doesn't display as the previous day in US time zones.
const formatted = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const categoryLabel = { event: 'Event', news: 'News', announcements: 'Announcements' }[frontmatter.category] ?? 'News';

// Frontmatter paths start with "/" (e.g. /img/news/photo.jpg); prefix the base URL so they
// also resolve on the GitHub Pages staging build.
const withBase = (src: string) => `${base}${src.replace(/^\//, '')}`;

// Optional photo gallery, listed in frontmatter so article files need no HTML:
//   gallery:
//     - src: /img/news/my-event/photo-1.jpg
//       alt: What the photo shows
const gallery = (frontmatter.gallery ?? []).map((photo: { src: string; alt?: string }) => ({
  src: withBase(photo.src),
  alt: photo.alt ?? `Photo from ${frontmatter.title}`,
}));
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  ogImage={frontmatter.image}
  ogType="article"
>
  <div class="white__band">
  <article class="news-article">

    <div class="news-article__hero">
      <img
        src={frontmatter.image ? withBase(frontmatter.image) : placeholderImg.src}
        alt={frontmatter.title}
        class="news-article__hero-img"
        width="1200"
        height="500"
      />
    </div>

    <div class="news-article__content">
      <div class="news-article__meta">
        <span class={`news-article__category news-article__category--${frontmatter.category}`}>{categoryLabel}</span>
        <time class="news-article__date" datetime={new Date(frontmatter.date).toISOString()}>{formatted}</time>
      </div>

      <h1 class="news-article__title">{frontmatter.title}</h1>

      <div class="news-article__body mdx-body">
        <slot />
        {gallery.length > 0 && (
          <>
            <h2>Photos</h2>
            <div class="news-article__gallery">
              {gallery.map(photo => (
                <a href={photo.src} target="_blank" rel="noopener noreferrer">
                  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          </>
        )}
      </div>

      <a href={`${base}community/news`} class="news-article__back">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true">
          <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
        Back to News
      </a>
    </div>

  </article>
  </div>
</BaseLayout>
