---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const formatted = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const categoryLabel = { event: 'Event', announcement: 'Announcement', other: 'News' }[frontmatter.category] ?? 'News';
---

<BaseLayout pageTitle={`${frontmatter.title} — Allegheny CIS`}>
  <div class="white__band">
  <article class="news-article">

    <div class="news-article__hero">
      <img
        src={frontmatter.image ?? `${base}img/placeholder.jpg`}
        alt={frontmatter.title}
        class="news-article__hero-img"
        width="1200"
        height="500"
      />
    </div>

    <div class="news-article__content">
      <div class="news-article__meta">
        <span class={`news-article__category news-article__category--${frontmatter.category}`}>{categoryLabel}</span>
        <time class="news-article__date" datetime={new Date(frontmatter.date).toISOString()}>{formatted}</time>
      </div>

      <h1 class="news-article__title">{frontmatter.title}</h1>

      <div class="news-article__body mdx-body">
        <slot />
      </div>

      <a href={`${base}community/news`} class="news-article__back">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true">
          <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
        Back to News
      </a>
    </div>

  </article>
  </div>
</BaseLayout>
