---
import { Image } from 'astro:assets';
import placeholderImg from '../assets/img/placeholder.jpg';

const { title, date, category, image, description, slug, externalUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const categoryClass = {
  event: 'update-card--event',
  announcement: 'update-card--announcement',
  other: 'update-card--other',
}[category];

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<a href={externalUrl ?? `${base}community/news/${slug}`} class={`update-card ${categoryClass}`} {...externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
  <div class="update-card__image">
    {image
      ? <img src={image} alt={title} width="640" height="360" loading="lazy" decoding="async" />
      : <Image src={placeholderImg} alt={title} />
    }
  </div>
  <div class="update-card__body">
    <p class="update-card__date">{formattedDate}</p>
    <h2 class="update-card__title">{title}</h2>
    <p class="update-card__desc">{description}</p>
  </div>
</a>
