---
type InstagramMedia = {
  id: string;
  media_type: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
  media_url?: string;
  thumbnail_url?: string;
  permalink: string;
  timestamp?: string;
};

const igToken = import.meta.env.INSTAGRAM_ACCESS_TOKEN;
const igProfileUrl = import.meta.env.PUBLIC_INSTAGRAM_PROFILE_URL || 'https://www.instagram.com/alleghenyacm/';

let instagramItems: InstagramMedia[] = [];

if (igToken) {
  try {
    const response = await fetch(
      `https://graph.instagram.com/me/media?fields=id,media_type,media_url,thumbnail_url,permalink,timestamp&limit=12&access_token=${igToken}`
    );

    if (response.ok) {
      const payload = await response.json();
      instagramItems = (payload?.data || [])
        .filter((item: InstagramMedia) => item.media_url || item.thumbnail_url)
        .sort((a: InstagramMedia, b: InstagramMedia) => {
          const aTime = a.timestamp ? Date.parse(a.timestamp) : 0;
          const bTime = b.timestamp ? Date.parse(b.timestamp) : 0;
          return bTime - aTime;
        })
        .slice(0, 4);
    }
  } catch {
    instagramItems = [];
  }
}

if (instagramItems.length < 4) {
  try {
    const profileUrl = new URL(igProfileUrl);
    const username = profileUrl.pathname.replace(/^\/+|\/+$/g, '').split('/')[0];

    if (username) {
      const response = await fetch(
        `https://www.instagram.com/api/v1/users/web_profile_info/?username=${username}`,
        {
          headers: {
            'User-Agent': 'Mozilla/5.0',
            'x-ig-app-id': '936619743392459'
          }
        }
      );

      if (response.ok) {
        const payload = await response.json();
        const edges = payload?.data?.user?.edge_owner_to_timeline_media?.edges || [];

        instagramItems = edges
          .map((edge: any) => {
            const node = edge?.node;
            if (!node?.display_url || !node?.shortcode) return null;

            return {
              id: String(node.id || node.shortcode),
              media_type: node.is_video ? 'VIDEO' : 'IMAGE',
              media_url: node.display_url,
              thumbnail_url: node.thumbnail_src || node.display_url,
              permalink: `https://www.instagram.com/p/${node.shortcode}/`,
              timestamp: node.taken_at_timestamp
                ? new Date(node.taken_at_timestamp * 1000).toISOString()
                : undefined
            } as InstagramMedia;
          })
          .filter((item: InstagramMedia | null): item is InstagramMedia => Boolean(item))
          .slice(0, 4);
      }
    }
  } catch {
    // Keep any previously fetched items; placeholders will fill missing slots.
  }
}

const footerImages = Array.from({ length: 4 }, (_, i) => instagramItems[i] ?? null);
---

<footer>
    <div class="header-line">
        <h2>Connect with us on</h2>
        <h1>socials</h1>
    </div>

    <div class="social-row">
        <div class="social-box"></div>
        <div class="social-box"></div>
        <div class="social-box"></div>
        <div class="social-box"></div>
        <div class="social-box"></div>
        <div class="social-box"></div>
        <div class="social-box"></div>
    </div>

    <div class="image-row">
        {footerImages.map((item) => (
          item ? (
            <a
              class="image-box image-box--link"
              href={item.permalink}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open Instagram post"
            >
              <img
                src={item.media_type === 'VIDEO' ? (item.thumbnail_url || item.media_url || '') : (item.media_url || item.thumbnail_url || '')}
                alt="Instagram post"
                loading="lazy"
              />
            </a>
          ) : (
            <a
              class="image-box image-box--placeholder"
              href={igProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open Instagram profile"
            ></a>
          )
        ))}
    </div>

    <div class="contact-section">
        <p><strong>Address:</strong><br />520 North Main Street<br />Meadville, PA 16335</p>
        <p><strong>Contact:</strong><br />814-332-4351<br />compsci@allegheny.edu</p>
    </div>
</footer>

<style>
  footer {
    background-color: #1B3054;
    color: #FFFFFF;
    padding: 1.5rem 2rem;
  }

  h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    color: #FEDA48;
    margin: 0;
  }

  h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    margin: 0;
  }

  .header-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .social-row {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: center;
    width: calc(100% / 4 * 1);
    max-width: 100%;
  }

  .social-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #D9D9D9;
    max-width: 20px;
  }

  .image-row {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
  }

  .image-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #D9D9D9;
    overflow: hidden;
    display: block;
  }

  .image-box--link {
    transition: transform 180ms ease;
  }

  .image-box--link:hover {
    transform: translateY(-2px);
  }

  .image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-box--placeholder {
    background: linear-gradient(135deg, #D9D9D9, #BFC4CC);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-left: 0.75rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }

  .contact-section p {
    margin: 0;
  }
</style>