---
import HeaderNav from './HeaderNav.jsx';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const navLinks = [
  {
    label: "Home",
    href: `${base}`,
  },
  {
    label: "About",
    href: `${base}about/statement`,
    children: [
      { label: "Our Purpose",  href: `${base}about/statement` },
      { label: "Action Plan",  href: `${base}about/actionplan` },
      { label: "Faculty",      href: `${base}about/faculty` },
      { label: "FAQs",      href: `${base}about/faq` },
      { label: "Facilities",  href: `${base}about/facilities` },
      { label: "Policies",    href: `${base}about/policies` },
    ],
  },
  {
    label: "Plan Your Path",
    href: `${base}plan/overview`,
    children: [
      { label: "My Path",   href: `${base}plan/4yearplan` },
      { label: "Majors & Minors",   href: `${base}plan/majorminor` },
      { label: "Microcredentials",   href: `${base}plan/microcredentials` },
      { label: "Research",   href: `${base}plan/research` },
      { label: "Cuppers",  href: `${base}plan/cuppers` },
      { label: "Study Away",   href: `${base}plan/studyaway` },
    ],
  },
  {
    label: "Resources",
    href: `${base}resources/overview`,
    children: [
      { label: "Overview",   href: `${base}resources/overview` },
      { label: "References", href: `${base}resources/references` },
      { label: "Laptops",    href: `${base}resources/laptops` },
    ],
  },
  {
    label: "Community",
    href: `${base}community/overview`,
    children: [
      { label: "Overview",    href: `${base}community/overview` },
      { label: "Calendar",    href: `${base}community/calendar` },
      { label: "News",        href: `${base}community/news` },
      { label: "Fundraising", href: `${base}community/fundraising` },
      { label: "Outreach",    href: `${base}community/outreach` },
    ],
  },
  {
    label: "Opportunities",
    href: `${base}opportunities/overview`,
    children: [
      { label: "Overview", href: `${base}opportunities/overview` },
      { label: "CMU",      href: `${base}opportunities/cmu` },
    ],
  },
];
---

<HeaderNav navLinks={navLinks} client:load />
