---
import FillButton from "../ui/FillButton.astro";
import GhostButton from "../ui/GhostButton.astro";
import { Image } from 'astro:assets';
import partnershipsImg from '../../assets/img/partnerships.jpg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="career" class="career-section gold__band">

    <div class="career-image">
        <Image src={partnershipsImg} alt="Professor presenting to students in a classroom" />
    </div>

    <div class="career-information">
        <h1>Partnerships &amp; Prospects for <em>your future</em></h1>
        <div class="career-information__body">
            <p>
                Allegheny computing graduates go on to careers at companies such as Google, Microsoft, and Intel, and to strong graduate programs. Along the way, our students intern at organizations including IBM, PNC, and MITRE and present their research at international conferences.
            </p>
            <p>
                Formal partnerships with Carnegie Mellon University offer accelerated paths to a graduate degree, including a 3-2 program with the Heinz College and a 4+1 program in business analytics with the Tepper School of Business, with guaranteed scholarship support at Heinz.
            </p>
            <div class="career-buttons">
                <a href={`${base}opportunities/overview`}><FillButton>CMU Partnerships</FillButton></a>
                <a href="https://allegheny.edu/academics/career-professional-development/" target="_blank" rel="noopener noreferrer"><GhostButton variant="dark">Job Opportunities</GhostButton></a>
            </div>
        </div>
    </div>

</section>
