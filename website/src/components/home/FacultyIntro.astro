---
import FillButton from "../ui/FillButton.astro";
import GhostButton from "../ui/GhostButton.astro";
import FacultyCarousel from "./FacultyCarousel.jsx";
import { getImage } from 'astro:assets';
import jj1Raw from '../../assets/img/jj1.png';
import obc1Raw from '../../assets/img/obc1.jpg';
import gk1Raw from '../../assets/img/gk1.jpeg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const [jj1, obc1, gk1] = await Promise.all([
  getImage({ src: jj1Raw,  format: 'webp' }),
  getImage({ src: obc1Raw, format: 'webp' }),
  getImage({ src: gk1Raw,  format: 'webp' }),
]);

const faculty = [
  {
    name: "Janyl Jumadinova, Ph.D.",
    title: "Department Chair, Associate Professor",
    statement:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus id egestas nibh, ac elementum velit. Donec aliquam eu ligula ac facilisis.\n\nMauris vel fermentum dui, ac semper lorem. Cras scelerisque dictum risus, sed hendrerit ante. Donec in sodales nisl. Fusce sed quam arcu. Donec mollis nisi sit amet mi hendrerit, sed dictum erat vestibulum. Maecenas vel risus elit. Pellentesque maximus felis eu ligula congue posuere.",
    image: jj1.src,
  },
  {
    name: "Oliver Bonham-Carter, Ph.D.",
    title: "Associate Professor",
    statement:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus id egestas nibh, ac elementum velit. Donec aliquam eu ligula ac facilisis.\n\nMauris vel fermentum dui, ac semper lorem. Cras scelerisque dictum risus, sed hendrerit ante. Donec in sodales nisl. Fusce sed quam arcu. Donec mollis nisi sit amet mi hendrerit, sed dictum erat vestibulum. Maecenas vel risus elit. Pellentesque maximus felis eu ligula congue posuere.",
    image: obc1.src,
  },
  {
    name: "Greg Kapfhammer, Ph.D.",
    title: "Associate Professor",
    statement:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus id egestas nibh, ac elementum velit. Donec aliquam eu ligula ac facilisis.\n\nMauris vel fermentum dui, ac semper lorem. Cras scelerisque dictum risus, sed hendrerit ante. Donec in sodales nisl. Fusce sed quam arcu. Donec mollis nisi sit amet mi hendrerit, sed dictum erat vestibulum. Maecenas vel risus elit. Pellentesque maximus felis eu ligula congue posuere.",
