---
import FillButton from "../ui/FillButton.astro";
import GhostButton from "../ui/GhostButton.astro";
import FacultyCarousel from "./FacultyCarousel.jsx";
import { getImage } from 'astro:assets';
import jj1Raw from '../../assets/img/faculty/jumadinova.png';
import obc1Raw from '../../assets/img/faculty/bonham-carter.jpg';
import gk1Raw from '../../assets/img/faculty/kapfhammer.jpeg';
import luman1Raw from '../../assets/img/faculty/luman1.png';
import mullins1Raw from '../../assets/img/faculty/mullins1.jpg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const [jj1, obc1, gk1, luman1, mullins1] = await Promise.all([
  getImage({ src: jj1Raw,  format: 'webp' }),
  getImage({ src: obc1Raw, format: 'webp' }),
  getImage({ src: gk1Raw,  format: 'webp' }),
  getImage({ src: luman1Raw, format: 'webp' }),
  getImage({ src: mullins1Raw, format: 'webp' }),
]);

const faculty = [
  {
    name: "Janyl Jumadinova, Ph.D.",
    title: "Department Chair, Associate Professor",
    statement:
      "Dr. Jumadinova's research explores autonomous systems that can improve our quality of life, from robotics to applied machine learning, with a focus on systems that perform complex tasks in dynamic, real-world environments.\n\nShe teaches across the curriculum, including introductory programming, algorithms, software engineering, artificial intelligence, robotics, and security, and as Department Chair she mentors students through research collaborations, independent studies, internships, and senior thesis projects.",
    image: jj1.src,
  },
  {
    name: "Oliver Bonham-Carter, Ph.D.",
    title: "Associate Professor",
    statement:
      "Dr. Bonham-Carter's research is rooted in data science, spanning bioinformatics and text analysis. He applies computational methods to questions in biology and health, such as the study of proteins involved in disease, and develops tools that draw insight from large collections of text and data.\n\nHe teaches data structures at the introductory level, specializes in teaching data science, and offers a range of upper-level and elective courses that connect computing to questions across the disciplines.",
    image: obc1.src,
  },
  {
    name: "Greg Kapfhammer, Ph.D.",
    title: "Associate Professor",
    statement:
      "Dr. Kapfhammer's research focuses on software engineering and software testing. He creates open-source tools that help developers build efficient and dependable software, and his work is used by researchers and practitioners around the world.\n\nAn Allegheny College graduate himself, he teaches courses in areas such as algorithm analysis, software engineering, and software testing, and he mentors students in designing, building, and rigorously evaluating real-world software.",
    image: gk1.src,
  },
  {
    name: "Douglas Luman",
    title: "Associate Professor",
    statement:
      "Professor Luman works at the intersection of computing and the arts. Their research and creative practice span computational poetry, book design, and the digital humanities, exploring what happens when algorithms become part of the creative process.\n\nThey teach courses that bridge computer science and design, including computer organization and industrial design fundamentals, and they bring a designer's perspective to helping students build and communicate with technology.",
    image: luman1.src,
  },
  {
    name: "Brett Mullins, Ph.D.",
    title: "Assistant Professor",
    statement:
      "Dr. Mullins's research focuses on trustworthy computing and statistical data privacy, including differential privacy, explainable machine learning, and synthetic data. His interdisciplinary background spans mathematics, philosophy, economics, and industry experience as a data scientist.\n\nHe teaches foundational and advanced courses, including introductory programming, data structures, algorithms, and applied data exploration, preparing students to reason carefully about both computation and data.",
    image: mullins1.src,
  },
];
---

<section id="faculty-intro" class="faculty-section white__band">

    <h1>World-class <em>Faculty & Staff</em></h1>

    <div class="scroll-fade">
        <FacultyCarousel faculty={faculty} client:visible />
    </div>

    <div class="faculty-buttons">
        <a href="/about/faculty"><FillButton variant="dark">View Faculty</FillButton></a>
        <a href="/about/statement"><GhostButton variant="dark">Our Purpose</GhostButton></a>
    </div>

</section>
