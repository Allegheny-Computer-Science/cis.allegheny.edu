---
import UpdateCard from '../ui/UpdateCard.astro';
import FillButton from '../ui/FillButton.astro';
import GhostButton from '../ui/GhostButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const mdxModules = import.meta.glob('../../pages/community/news/*.mdx', { eager: true });
const latest = Object.entries(mdxModules)
  .map(([file, mod]: [string, any]) => ({ file, ...mod.frontmatter }))
  .sort((a: any, b: any) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 4);
---

<section id="recent-updates" class="updates-section navy__band">

  <h1>Recent <em>Updates</em></h1>

  <div class="scroll-fade">
  <div class="updates-grid">
    {latest.map((entry: any) => (
      <UpdateCard
        title={entry.title}
        date={new Date(entry.date)}
        category={entry.category}
        image={entry.image}
        description={entry.description}
        slug={entry.file.split('/').at(-1).replace('.mdx', '')}
      />
    ))}
  </div>
  </div>

  <div class="updates-buttons">
    <a href={`${base}community/news`}><FillButton variant="light">More Updates</FillButton></a>
    <a href="#faculty-intro"><GhostButton>About Us</GhostButton></a>
  </div>

</section>
