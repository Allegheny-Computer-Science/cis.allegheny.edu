---
import FillButton from "../ui/FillButton.astro";
import GhostButton from "../ui/GhostButton.astro";
import { Image } from 'astro:assets';
import peerSupportImg from '../../assets/img/peer-support.jpg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="community" class="community-section gold__band">

    <div class="community-information">
        <h1>Unparalleled peer support and <em>technical community</em></h1>
        <div class="community-information__body">
            <p>
                In Alden Hall, you will find a community where students learn together rather than compete. Classmates collaborate in weekly labs, study groups form naturally, and questions are always welcome, whether you arrive with years of coding experience or none at all.
            </p>
            <p>
                Trained student mentors called Technical Leaders hold regular office hours to help you master new tools and debug your work, and our Technical Advisory Board of alumni and industry professionals keeps the department connected to the wider world of computing.
            </p>
            <div class="community-buttons">
                <a href={`${base}community/tl`}><FillButton>Tech Leaders</FillButton></a>
                <a href={`${base}community/tab`}><GhostButton variant="dark">Tech Advisory Board</GhostButton></a>
            </div>
        </div>
    </div>

    <div class="community-image">
        <Image src={peerSupportImg} alt="Students collaborating with laptops" />
    </div>

</section>
