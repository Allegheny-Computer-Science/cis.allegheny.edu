---
import FillButton from "../ui/FillButton.astro"
import GhostButton from "../ui/GhostButton.astro"
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholderImg from '../../assets/img/placeholder.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const heroGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/hero/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

// Sort by filename so hero-1, hero-2 … hero-N come out in order
const heroImages = Object.entries(heroGlob)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);

const slides  = heroImages.length > 0 ? heroImages : [placeholderImg];
const n       = slides.length;
const perSlide = 4;                  // seconds each slide is shown
const total   = n * perSlide;        // total animation cycle
---

<section id="hero" class="hero-section navy__band">

    <div class="hero-image" style={`--hero-n:${n};--hero-total:${total}s;--hero-per:${perSlide}s;`}>
      {slides.map((img, i) => (
        <div
          class={`hero-slide${n === 1 ? ' hero-slide--static' : ''}`}
          style={`animation-delay:${i * perSlide}s;`}
        >
          <Image
            src={img}
            alt="Allegheny CIS students and community"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            width={900}
            height={700}
          />
        </div>
      ))}
    </div>

    <div class="hero-information">
        <h1>Why <em>Allegheny College</em> Computer & Information Science?</h1>
        <div class="hero-information__body">
            <p>
                Computing careers are the fastest growing in STEM &mdash; and at Allegheny, you will graduate ready to lead them. Our programs in Computer Science, Data Science, Informatics, and Software Engineering pair rigorous foundations with hands-on practice from your first semester.
            </p>
            <p>
                You will design and release real applications, analyze data, and build open-source tools used beyond the classroom &mdash; all while learning to communicate clearly, collaborate across disciplines, and engage with the social and ethical dimensions of technology.
            </p>
            <div class="hero-buttons">
                <a href={`${base}plan/degrees`}><FillButton>Our Programs</FillButton></a>
                <a href={`${base}plan/mypath`}><GhostButton>Plan Your Path</GhostButton></a>
            </div>
        </div>
    </div>

</section>
