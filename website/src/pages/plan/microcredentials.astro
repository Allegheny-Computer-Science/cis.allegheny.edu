---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Microcredentials";

const microcredentials = [
    {
        title: "AI-Driven Content Creation",
        description: "AI-Driven Content creation equips students with contemporary strategies and tools for creating images, video, and text such as prompt engineering and large language model (LLM) model fine-tuning. Students completing this microcredential will be able to generate intentional and consistent results in response to a wide variety of purposes, including artistic and industrial applications.",
        competencies: [
            "Create images, text, audio, and video using industry-standard platforms and models",
            "Write successful model prompts using platform-specific best practices to yield consistent, high-quality results",
            "Revise model outputs using iterative design practices and AI-informed design tools"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "ART 187 - Electronic & Intermedia Art",
                    "CMPSC 303 - Artificial Intelligence*",
                    "CMPSC 350 - Computational Narrative*"
                ]
            }
        ],
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Content Creation",
        description: "Content Creation will develop students' skills in producing images, video, and sound-based content and instructing them on effective deployment through web development and/or contemporary marketing practices.",
        competencies: [
            "Demonstrate camera use fundamentals",
            "Develop production, sound editing, web development and design tool fundamentals",
            "Identify contemporary marketing practice"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "ART 171 - Photography",
                    "ART 187 - Electronic & Intermedia Art",
                    "CMPSC 302 - Web Development"
                ]
            }
        ]
    },
    {
        title: "Artificial Intelligence Engineering",
        description: "The Artificial Intelligence Engineering microcredential equips students with the skills to integrate machine learning techniques into new software for autonomously solving real-world problems beyond standard benchmarks. Through the coursework, students will critically evaluate how the convergence of modern tools and new applications can proceed ethically and sustainably.",
        competencies: [
            "Incorporate modern machine learning libraries in software applications",
            "Implement systems for solving real-world problems with AI",
            "Weigh the ethical impacts of AI-enabled software for individuals and society"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (8 credits):",
                courses: [
                    "CMPSC 101 - Data Structure",
                    "CMPSC 203 - Software Engineering"
                ]
            },
            {
                heading: "Take one of the following courses (4 credits):",
                courses: [
                    "CMPSC 303 - Artificial Intelligence",
                    "CMPSC 405 - Deep Learning*"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Cybersecurity Risk Analysis",
        description: "Cybersecurity Risk Analysis introduces the knowledge and skills that students need to design, implement, and deploy secure software systems. Students who complete this microcredential will have the demonstrated ability to identify and resolve cyber-security risks through the analysis of a system's design and implementation.",
        competencies: [
            "Build and use automated software tools, like penetration testing techniques and automated threat scanners",
            "Mitigate cybersecurity risks by identifying and repairing the vulnerabilities in the implementation and use of a software system",
            "Create and present audit reports that effectively characterize the strengths and weaknesses of a software system's security profile"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "CMPSC 200 - Computer Organization*",
                    "CMPSC 400 - Operating Systems",
                    "CMPSC 403 - Computer Security"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Data Analysis with Python and R",
        description: "Data Analysis with Python and R introduces the knowledge and skills that students need to effectively make decisions using varied data sources. Students who complete this microcredential will have the ability to use the Python and R programming languages to create data visualizations, perform statistical analyses, and train machine learning models that yield actionable insights and support decision-making.",
        competencies: [
            "Perform exploratory data analysis and visualization",
            "Train, validate, and apply machine learning models",
            "Automatically model and mine text documents",
            "Deploy visual data analytics dashboards",
            "Use commercial data analysis platforms"
        ],
        courseGroups: [
            {
                heading: "Take the following courses (4 credits):",
                courses: [
                    "CMPSC 301 - Data Science"
                ]
            },
            {
                heading: "And take two of the following courses (8 credits):",
                courses: [
                    "CMPSC 100 - Computational Expression",
                    "CMPSC 101 - Data Structures",
                    "CMPSC 102 - Discrete Structures"
                ]
            }
        ]
    },
    {
        title: "Data-driven Health Informatics",
        description: "Data-driven Health Informatics microcredential provides foundational knowledge and skills in finding, understanding, organizing, visualizing, and extracting information from health-related data. Students who complete this microcredential will be able to explore publicly available health and genetic data, and use open-source web tools, Python programming, and Stata software package to learn insights from this data.",
        competencies: [
            "Employ database management and software packages to collect, analyze, store, retrieve and run queries on publicly available health data",
            "Use industry-standard web-based and computational library-based tools, and bio/health algorithms to process, explore, examine and analyze health and genetic data",
            "Demonstrate, articulate and document health information and all the processes by which health data is generated"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "CMPSC 100 - Computational Expression",
                    "CMPSC 300 - Bioinformatics",
                    "GHS 228 - Global Health Data and Visualization"
                ]
            }
        ]
    },
    {
        title: "Embedded Systems Engineering",
        description: "Embedded Systems Engineering microcredential equips students with the skills to develop and optimize software for hardware systems. Students who complete this microcredential will have the demonstrated ability to design efficient, high-performance embedded applications while utilizing memory management, parallel processing, and secure communication.",
        competencies: [
            "Execute high-level code on hardware, manage memory, and leverage parallel processing to maximize efficiency in C and Assembly",
            "Design and manage domain-specific software, applying best practices for project management and using Python for testing and debugging",
            "Develop operating systems or Internet of Things applications with a focus on memory management, secure communication, and performance optimization"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (8 credits):",
                courses: [
                    "CMPSC 200 - Computer Organization*",
                    "CMPSC 203 - Software Engineering*"
                ]
            },
            {
                heading: "Take one of the following courses (4 credits):",
                courses: [
                    "CMPSC 304 - Robotic Agents*",
                    "CMPSC 406 - Internet of Things"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Game Design",
        description: "The Game Design microcredential allows students to develop crucial skills for conceptualizing, designing, and building video games. Skills include electronic art, game logic, and web-based interactive interfaces. In addition, students learn how to think conceptually in areas like digital space, story, and level design. These skills apply in the fast-growing gaming industry as well as other engineering and design contexts.",
        competencies: [
            "Design and build interactive interfaces for local and online gaming applications",
            "Create intelligent agents that carry out game logic",
            "Conceptualize game mechanics and narratives"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "ART 287 - Art at the Intersection of Science and Culture*",
                    "CMPSC 303 - Artificial Intelligence*",
                    "CMPSC 404 - Web Applications*"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Product Development in the Internet of Things",
        description: "Product Development in the Internet of Things provides students hands-on experience with creating smart devices using the principles of human-computer interaction (HCI), and user-centered design (UCD). Students will develop and prototype physical devices incorporating industry grade software and hardware such as the Raspberry Pi, Teensy, or ESP32 platforms to design reproducible, manufacturable, technical solutions which respond to and/or supplement human needs.",
        competencies: [
            "Describe principles of user-centered design (UCD)",
            "Apply tools that integrate hardware and software consistent with best practices of human-computer interaction (HCI)",
            "Write and distribute documentation and hardware schematics with consideration of device reproducibility"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (8 credits):",
                courses: [
                    "CMPSC 100 - Computational Expression",
                    "CMPSC 200 - Computer Organization*"
                ]
            },
            {
                heading: "And one of the following courses (4 credits):",
                courses: [
                    "CMPSC 304 - Robotic Agents*",
                    "CMPSC 406 - Internet of Things"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Programming with Web Technologies",
        description: "Programming with Web Technologies teaches students how to develop accessible, aesthetically pleasing, and well-organized websites and web applications. In addition to attaining the knowledge and skills needed to benchmark, maintain, and enhance websites, students who complete this microcredential will be able to design the user experiences and interfaces for compelling and dynamic web projects.",
        competencies: [
            "Structure web content using semantic and accessible HTML and CSS",
            "Develop web applications using JavaScript and TypeScript",
            "Perform automated testing with Cypress and Playwright",
            "Deploy interactive web applications implemented with React",
            "Use static site generators JAMStack and publish to Netlify or Vercel"
        ],
        courseGroups: [
            {
                heading: "Take the following course (4 credits):",
                courses: [
                    "CMPSC 302 - Web Design*"
                ]
            },
            {
                heading: "And take two of the following courses (8 credits):",
                courses: [
                    "CMPSC 100 - Computational Expression",
                    "CMPSC 101 - Data Structures",
                    "CMPSC 102 - Discrete Structures"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Site Reliability Engineering",
        description: "Site Reliability Engineering develops students' ability to manage large software systems with a focus on maintaining system reliability. Students who complete this microcredential will be able to develop and use intelligent monitoring tools to anticipate and address technical instability to prevent system failures.",
        competencies: [
            "Analyze software reliability and performance metrics using log analysis tools",
            "Design and implement automated systems intended to monitor and ensure software system uptime for critical software components",
            "Develop testing methods and protocols consistent with industrial best practices and industry-grade software tooling"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (12 credits):",
                courses: [
                    "CMPSC 203 - Software Engineering*",
                    "CMPSC 303 - Artificial Intelligence*"
                ]
            },
            {
                heading: "Take one of the following (4 credits):",
                courses: [
                    "CMPSC 302 - Web Design*",
                    "CMPSC 404 - Applications"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    },
    {
        title: "Software Development with Python",
        description: "Software Development with Python introduces the knowledge and skills that students need to engineer, release, and maintain software implemented in the Python programming language. Students who complete this microcredential will have the demonstrated ability to make high-quality contributions to both the source code and technical documentation in software projects stored in GitHub repositories.",
        competencies: [
            "Use the object-oriented programming paradigm in Python",
            "Perform automated software testing with Pytest",
            "Set up continuous integration and delivery with GitHub Actions",
            "Create technical documentation using MkDocs",
            "Use Poetry to release and maintain software on PyPI"
        ],
        courseGroups: [
            {
                heading: "Take the following courses (8 credits):",
                courses: [
                    "CMPSC 100 - Computational Expression",
                    "CMPSC 101 - Data Abstraction"
                ]
            },
            {
                heading: "And take one of the following courses (4 credits):",
                courses: [
                    "CMPSC 201 - Programming Languages",
                    "CMPSC 203 - Software Engineering"
                ]
            }
        ]
    },
    {
        title: "Software Performance Engineering",
        description: "Software Performance Engineering introduces the knowledge and skills that students need to design, implement, and deploy correct and efficient software. Students who complete this microcredential will have the demonstrated ability to conduct experiments that characterize a software system's performance, pinpoint and resolve software performance bottlenecks, and optimize system performance without compromising correctness.",
        competencies: [
            "Implement and use automated software tools that conduct performance benchmarks",
            "Analyze performance data to identify software performance bottlenecks and design, implement, and deploy solutions to solve performance problems",
            "Create and present technical reports that effectively characterize the performance of a software system"
        ],
        courseGroups: [
            {
                heading: "Take all of the following courses (8 credits):",
                courses: [
                    "CMPSC 101 - Data Structures",
                    "CMPSC 202 - Algorithm Analysis"
                ]
            },
            {
                heading: "Take one of the following courses (4 credits):",
                courses: [
                    "CMPSC 303 - Artificial Intelligence",
                    "CMPSC 305 - Database Systems",
                    "CMPSC 400 - Operating Systems*"
                ]
            }
        ]
        ,
        note: "*Additional prerequisite not in microcredential requirements."
    }
];
---
<BaseLayout pageTitle={pageTitle}>
    <div style="background-color: #1B3054; min-height: 100vh; padding: 2rem;">
        <div class="header-line">
            <h1>Microcredentials</h1>
        </div>

        <section class="intro-section">
            <p>Microcredentials are digital badges used to help match employers and graduate schools with candidates who have achieved a set of well-defined skills, competencies and strengths within a field of study. These badges, when included on application portals like Indeed and LinkedIn, help job and graduate school applicants rise through an algorithmically parsed applicant pool in ways that a degree alone might not. Each microcredential consists of a small number of credit-bearing courses (typically three) specifically packaged together to highlight the skill or competency students will gain. In many cases, students may earn these badges through completing coursework that can also fulfill requirements of their academic major and minor programs. Specific Microcredentials offered through the Computer Science Program are listed below.</p>

            <div class="accordion-section">
                <h2>Available Microcredentials</h2>
                <div class="accordion-list">
                    {[...microcredentials]
                        .sort((a, b) => a.title.localeCompare(b.title))
                        .map((credential) => (
                        <details class="credential-card">
                            <summary>{credential.title}</summary>
                            <div class="credential-content">
                                <div class="credential-left">
                                    <p>{credential.description}</p>
                                    <div class="credential-actions">
                                        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfTcqaLIuCuZCMESshLTOLyc5m-yHF53zYbQ7tK8u28guD0lg/viewform" class="action-button signup-button" target="_blank" rel="noopener noreferrer">Sign Up</a>
                                        <a href="https://www.credly.com/organizations/allegheny-college/badges" class="action-button credly-button" target="_blank" rel="noopener noreferrer">Credly</a>
                                    </div>
                                </div>
                                <div class="credential-right">
                                    <h3>Competencies Gained:</h3>
                                    <ul>
                                        {credential.competencies.map((item) => (
                                            <li>{item}</li>
                                        ))}
                                    </ul>
                                    {credential.courseGroups.map((group) => (
                                        <>
                                            <h3>{group.heading}</h3>
                                            <ul>
                                                {group.courses.map((course) => (
                                                    <li>{course}</li>
                                                ))}
                                            </ul>
                                        </>
                                    ))}
                                    {credential.note && <p class="credential-note">{credential.note}</p>}
                                </div>
                            </div>
                        </details>
                    ))}
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    h1 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 64px;
        color: #FEDA48;
        margin-bottom: -0.25rem;
        line-height: 1;
    }

    .intro-section {
        color: #F5F7FA;
        line-height: 1.7;
        max-width: 100%;
    }

    .intro-section p {
        margin-top: 0;
    }

    .accordion-section {
        margin-top: 2rem;
        width: 100%;
    }

    .accordion-section h2 {
        font-size: 32px;
        color: #FEDA48;
        margin-bottom: 1rem;
    }

    .accordion-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .credential-card {
        background-color: #1B3054;
        border: 2px solid #FFFFFF;
        border-radius: 0;
        padding: 0.75rem 1rem;
        box-shadow: none;
    }

    summary {
        font-family: 'Bebas Neue', sans-serif;
        cursor: pointer;
        color: #FFFFFF;
        font-size: 22px;
        letter-spacing: 0.02em;
        font-weight: 600;
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    summary::after {
        content: '⌄';
        font-size: 1.1rem;
        color: #FFFFFF;
        transition: transform 180ms ease;
    }

    .credential-card[open] summary::after {
        transform: rotate(180deg);
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .credential-content {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: minmax(220px, 0.9fr) minmax(360px, 1.4fr);
        gap: 2rem;
        border: 2px solid #FFFFFF;
        padding: 1.4rem;
    }

    .credential-left p {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.55;
        text-transform: uppercase;
        font-weight: 700;
        max-width: 30ch;
    }

    .credential-left {
        display: flex;
        flex-direction: column;
    }

    .credential-right h3 {
        margin: 0;
        color: #FEDA48;
        font-family: 'Bebas Neue', sans-serif;
        letter-spacing: 0.03em;
        font-size: 2rem;
        font-weight: 400;
        text-transform: uppercase;
    }

    .credential-right ul {
        margin: 0.35rem 0 1.5rem 1.2rem;
        padding: 0;
    }

    .credential-right li {
        margin-bottom: 0.35rem;
        font-size: 1.05rem;
        line-height: 1.4;
        text-transform: uppercase;
        font-family: 'Inter', sans-serif;
    }

    .credential-note {
        margin: -0.25rem 0 0;
        font-size: 0.92rem;
        line-height: 1.35;
        text-transform: uppercase;
        font-family: 'Inter', sans-serif;
    }

    .credential-actions {
        margin-top: auto;
        padding-top: 1.75rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 125px;
        min-height: 52px;
        padding: 0.4rem 1.2rem;
        text-decoration: none;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.7rem;
        letter-spacing: 0.02em;
        color: #FFFFFF;
        border: 2px solid transparent;
        transition: transform 160ms ease, border-color 160ms ease;
    }

    .signup-button {
        background: #83C53F;
        color: #FFFFFF;
    }

    .credly-button {
        background: #FEDA48;
        color: #1B3054;
    }

    .action-button:hover,
    .action-button:focus-visible {
        transform: translateY(-2px);
        border-color: #FFFFFF;
        outline: none;
    }

    @media (max-width: 1000px) {
        .credential-content {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .credential-left p {
            max-width: none;
        }
    }

    @media (max-width: 700px) {
        h1 {
            font-size: 48px;
        }

        .accordion-section h2 {
            font-size: 26px;
        }

        summary {
            font-size: 1.35rem;
        }

        .credential-content {
            padding: 1rem;
        }

        .credential-right h3 {
            font-size: 1.6rem;
        }

        .credential-right li,
        .credential-left p {
            font-size: 0.95rem;
        }

        .action-button {
            min-width: 110px;
            min-height: 48px;
            font-size: 1.45rem;
        }
    }
</style>