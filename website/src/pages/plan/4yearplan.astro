---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Plan Your Path";
---

<BaseLayout pageTitle={pageTitle}>
    <div style="background-color: #1B3054; min-height: 100vh; padding: 2rem;">
        <div class="header-line">
            <h1>Plan your</h1>
            <h2>4 year journey</h2>
        </div>
        <p class="page-intro">Curious to what the future holds? See your potential next 4 years with our 4 year journey planner.</p>

    <section class="dropdown-row" aria-label="Plan options">
      <details class="dropdown">
        <summary class="button__ghost dropdown-toggle">Select Major</summary>
        <div class="dropdown-menu">
          <p>Computer Science</p>
          <p>Data Science</p>
          <p>Informatics</p>
          <p>Software Engineering</p>
        </div>
      </details>
      <details class="dropdown">
        <summary class="button__ghost dropdown-toggle">Select Grad Year</summary>
        <div class="dropdown-menu">
          <p>2026</p>
          <p>2027</p>
          <p>2028</p>
        </div>
      </details>
    </section>

    <section class="updates-grid" style="margin-top: 2rem;">
      <article class="update-card1">
        <div class="update-card__body">
          <h3 class="update-card__title">YEAR 1</h3>
          <div class="class-list">
            <div class="class-item"><span class="class-name">CS 101</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 102</span><span class="class-credits">4 credits</span></div>
          </div>
          <div class="credits-summary">
            <p><strong>Total CS Credits Completed:</strong> 8</p>
            <p><strong>Credits Remaining in Major:</strong> 40</p>
          </div>
        </div>
      </article>
      <article class="update-card2">
        <div class="update-card__body">
          <h3 class="update-card__title">YEAR 2</h3>
          <div class="class-list">
            <div class="class-item"><span class="class-name">CS 201</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 202</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 204 - Databases</span><span class="class-credits">4 credits</span></div>
          </div>
          <div class="credits-summary">
            <p><strong>Total CS Credits Completed:</strong> 20</p>
            <p><strong>Credits Remaining in Major:</strong> 28</p>
          </div>
        </div>
      </article>
      <article class="update-card1">
        <div class="update-card__body">
          <h3 class="update-card__title">YEAR 3</h3>
          <div class="class-list">
            <div class="class-item"><span class="class-name">CS 301 - Operating Systems</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 302 - Computer Networks</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 303 - Artificial Intelligence</span><span class="class-credits">4 credits</span></div>
          </div>
          <div class="credits-summary">
            <p><strong>Total CS Credits Completed:</strong> 32</p>
            <p><strong>Credits Remaining in Major:</strong> 16</p>
          </div>
        </div>
      </article>
      <article class="update-card2">
        <div class="update-card__body">
          <h3 class="update-card__title">YEAR 4</h3>
          <div class="class-list">
            <div class="class-item"><span class="class-name">CS 401 - Senior Comp I</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 402 - Senior Comp II</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 410 - Advanced Topics</span><span class="class-credits">4 credits</span></div>
            <div class="class-item"><span class="class-name">CS 420 - Systems Seminar</span><span class="class-credits">4 credits</span></div>
          </div>
          <div class="credits-summary">
            <p><strong>Total CS Credits Completed:</strong> 48</p>
            <p><strong>Credits Remaining in Major:</strong> 0</p>
          </div>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    color: #FEDA48;
    margin-bottom: 1rem;
  }

    h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 64px;
        color: #FFFFFF;
        margin-bottom: 1rem;
    }

  p {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #FFFFFF;
  }

  p2 {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #1B3054
  }

  .header-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .header-line h1 {
    margin: 0;
  }

  .page-intro {
    margin-top: 0;
    margin-bottom: 1rem;
  }


  .updates-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .update-card1 {
    flex: 1 1 calc((100% - 3rem) / 4);
    min-width: 0;
    background: #1B3054;
    border: 2px solid #80BD41;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    border-bottom: 20px solid #80BD41;
  }

  .update-card2 {
    flex: 1 1 calc((100% - 3rem) / 4);
    min-width: 0;
    background: #1B3054;
    border: 2px solid #FEDA48;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    border-bottom: 20px solid #FEDA48;
  }

  .update-card__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    justify-content: space-between;
  }

  .update-card__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px;
    color: #FEDA48;
    margin: 0;
    text-transform: uppercase;
  }

  .class-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex: 1;
  }

  .class-item {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  .class-credits {
    color: #FEDA48;
    white-space: nowrap;
  }

  .class-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  .class-name,
  .class-credits {
    display: inline-block;
  }

  .class-item {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  .credits-summary {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .credits-summary p {
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  .button__ghost {
    display: inline-grid;
    width: fit-content;
    padding: 0.75rem 1rem;
    border: 2px solid #ffffff;
    background-color: #80BD41;
    color: #FFFFFF;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
    cursor: pointer;
  }

  .button__ghost:hover {
    background-color: #FFFFFF;
    color: #1B3054;
  }

  .dropdown-row {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    margin: 1rem 0 1.5rem;
    align-items: flex-start;
  }

  .dropdown {
    position: relative;
    flex: 1 1 0;
    max-width: 240px;
  }

  .dropdown-toggle {
    list-style: none;
    border: 2px solid #80BD41;
    min-width: 100%;
    justify-content: center;
    text-align: center;
  }

  .dropdown-toggle::-webkit-details-marker {
    display: none;
  }

  .dropdown-menu {
    margin-top: 0.5rem;
    padding: 1rem;
    background-color: #FFFFFF;
    border: 2px solid #FEDA48;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 220px;
  }

  .dropdown-menu p {
    margin: 0;
    color: #1B3054;
    font-size: 15px;
  }

  .info-section {
    margin-top: 2rem;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 2rem;
    width: 100vw;
    background-color: #FFFFFF !important;
    color: #1B3054;
    border-radius: 0;
    border: none;
    box-sizing: border-box;
  }

  .info-section h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    margin-top: 0;
    margin-bottom: 1rem;
    color: #1B3054;
  }

  .info-section p {
    color: #1B3054;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 0;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    min-height: 320px;
    overflow: hidden;
    width: 100vw;
  }

  .split-panel {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 1rem;
  }

  .split-panel--light {
    background-color: #FEDA48;
    color: #1B3054;
  }

  .split-panel--dark {
    background-color: #F6E9A8;
    color: #1B3054;
  }

  .split-panel h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    margin: 0 0 1rem;
    color: #1B3054;
  }

  .split-panel p {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
    color: #1B3054;
  }

h5 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 96px;
    color: #1B3054
    margin-bottom: .5rem;
  }

h6 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px;
    color: #1B3054
  }

h7 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 64px;
    color: #1B3054
}

</style>
