---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import UpdatesGrid from '../components/home/Updates.astro';
import FacultyIntro from '../components/home/FacultyIntro.astro';
import LeftBand from '../components/home/LeftBand.astro';
import StudentOrgs from '../components/home/StudentOrgs.astro';
import RightBand from '../components/home/RightBand.astro';
import EndorsementWheel from '../components/home/EndorsementWheel.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>
	<Hero />
	<UpdatesGrid />
	<FacultyIntro />
	<LeftBand />
	<StudentOrgs />
	<RightBand />
	<EndorsementWheel />
</BaseLayout>
