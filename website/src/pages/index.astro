---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import UpdatesGrid from '../components/home/Updates.astro';
import FacultyIntro from '../components/home/FacultyIntro.astro';
import CommunityBand from '../components/home/CommunityBand.astro';
import StudentOrgs from '../components/home/StudentOrgs.astro';
import CareerBand from '../components/home/CareerBand.astro';
import EndorsementWheel from '../components/home/EndorsementWheel.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>
	<Hero />
	<UpdatesGrid />
	<FacultyIntro />
	<CommunityBand />
	<StudentOrgs />
	<CareerBand />
	<EndorsementWheel />
</BaseLayout>
