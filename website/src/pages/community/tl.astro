---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FillButton from '../../components/ui/FillButton.astro';
import { technicalLeaders } from '../../data/tl.js';
import { CALENDAR_EMBED_URL } from '../../config/calendar';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/img/tl/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const tls = [...technicalLeaders].sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout pageTitle="Technical Leaders | Allegheny CIS">
  <section class="tl-dir white__band">

    <h1 class="faculty-dir__heading">Technical <em>Leaders</em></h1>
    <p class="tl-dir__intro">Technical Leaders are experienced CIS students who serve as a peer support network for the department. They assist in introductory courses and host regular office hours in Alden Hall — offering guidance, debugging help, and a friendly face for students who are new to the field.</p>
    <div class="tl-dir__actions">
      <a href={CALENDAR_EMBED_URL} target="_blank" rel="noopener noreferrer">
        <FillButton>View Office Hours Calendar</FillButton>
      </a>
    </div>

    {tls.length === 0 ? (
      <p style="color: var(--navy);">No Technical Leaders listed yet.</p>
    ) : (
      <div class="tl-dir__grid">
        {tls.map(d => {
          const imgMod = d.image ? images[`/src/assets/img/tl/${d.image}`] : null;
          return (
            <div class="tl-card">
              <div class="tl-card__image">
                {imgMod
                  ? <Image src={imgMod.default} alt={d.name} width={300} height={300} />
                  : <div class="tl-card__image-placeholder" aria-hidden="true" />
                }
              </div>
              <div class="tl-card__body">
                <h2 class="tl-card__name">{d.name}</h2>
                <div class="tl-card__academics">
                  <span class="tl-card__major">{d.major}</span>
                  {d.minor && <span class="tl-card__minor">Minor: {d.minor}</span>}
                </div>
                {d.officeHours && (
                  <div class="tl-card__hours">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm.5 5v5.25l4.5 2.67-.75 1.23L11 13V7h1.5z"/></svg>
                    {d.officeHours}
                  </div>
                )}
                {d.skills && d.skills.length > 0 && (
                  <ul class="tl-card__skills">
                    {d.skills.map(skill => <li class="tl-card__skill">{skill}</li>)}
                  </ul>
                )}
              </div>
            </div>
          );
        })}
      </div>
    )}

  </section>
</BaseLayout>
