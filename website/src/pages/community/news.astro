---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsFilter from '../../components/ui/NewsFilter.jsx';
import NewsFilterBar from '../../components/ui/NewsFilterBar.jsx';
import { CALENDAR_EMBED_URL } from '../../config/calendar';

const mdxModules = import.meta.glob('./news/*.mdx', { eager: true });

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const updates = Object.entries(mdxModules).map(([file, mod]: [string, any]) => ({
  slug: file.replace('./news/', '').replace('.mdx', ''),
  title: mod.frontmatter.title,
  date: new Date(mod.frontmatter.date).toISOString(),
  category: mod.frontmatter.category,
  image: mod.frontmatter.image ?? null,
  description: mod.frontmatter.description,
  externalUrl: mod.frontmatter.externalUrl ?? null,
})).sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

// Sidebar shows the 2 most recent events only
const sidebarItems = updates.filter(u => u.category === 'event').slice(0, 2);
const sidebarSlugs = new Set(sidebarItems.map(u => u.slug));
const gridItems = updates.filter(u => !sidebarSlugs.has(u.slug));
---

<BaseLayout pageTitle="Calendar & News | Allegheny CIS">
  <div class="community-feed white__band">

    <h1 class="community-feed__heading">Department <em>Calendar &amp; Updates</em></h1>

    <!--
      Desktop: 4-col grid — left (3 cols, flex column: calendar + note) | sidebar (1 col, event cards)
      Tablet/mobile: sidebar + filterbar hidden, news shows inline filter bar
    -->
    <div class="community-feed__top">

      <!-- Left: calendar + filter bar stacked -->
      <div class="community-feed__left">
        <section class="community-feed__calendar">
          <div class="calendar-page__embed-wrap">
            <iframe
              src={CALENDAR_EMBED_URL}
              class="calendar-page__embed"
              title="Allegheny CIS Department Calendar"
              frameborder="0"
              scrolling="no"
              loading="lazy"
            ></iframe>
          </div>
        </section>

        <p class="calendar-page__note">Click on a <strong>TL Office Hours</strong> event to see which Technical Leaders will be in attendance.</p>
      </div>

      <!-- Right: upcoming event cards, clipped to column height -->
      <div class="community-feed__sidebar">
        <p class="community-feed__sidebar-label">Recent & Upcoming Events</p>
        {sidebarItems.map(u => (
          <a
            href={u.externalUrl ?? `${base}community/news/${u.slug}`}
            class={`update-card update-card--${u.category} update-card--light`}
            {...(u.externalUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <div class="update-card__image">
              <img src={u.image ?? `${base}img/placeholder.jpg`} alt={u.title} width="640" height="360" loading="lazy" decoding="async" />
            </div>
            <div class="update-card__body">
              <p class="update-card__date">{new Date(u.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h2 class="update-card__title">{u.title}</h2>
              <p class="update-card__desc">{u.description}</p>
            </div>
          </a>
        ))}
      </div>

    </div>

    <!-- News grid: excludes items already shown in the sidebar -->
    <section class="community-feed__news">
      <h2 class="community-feed__archive-heading">News <em>Archive</em></h2>
      <div class="community-feed__filterbar">
        <NewsFilterBar client:load />
      </div>
      <NewsFilter updates={gridItems} baseUrl={base} client:load />
    </section>
  </div>
</BaseLayout>
