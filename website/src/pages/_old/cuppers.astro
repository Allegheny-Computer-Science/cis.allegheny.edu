---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = "Cuppers";
---
<BaseLayout pageTitle={pageTitle}>
  <main class="cuppers-page">
        <div class="header-line">
            <h1>Cuppers</h1>
            <h2>Scholarship Program</h2>
    </div>

    <section class="intro-panel">
      <p>The Cupper Scholars Program offers Allegheny College students the opportunity to conduct collaborative research with faculty mentors while building strong academic and professional foundations. Designed to support students beginning their first research experience, the program provides structured mentoring, hands-on project involvement, and access to the Professor Robert D. Cupper Research Scholar Program Fund, which supplies research and travel support for selected participants.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .cuppers-page {
    background: linear-gradient(165deg, #1b3054 0%, #162744 100%);
    min-height: 100vh;
    padding: 2rem;
  }

    h1 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 64px;
        color: #FEDA48;
    margin: 0;
    line-height: 1;
    }

    h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 64px;
        color: #FFFFFF;
    margin: 0;
    line-height: 1;
    }

  .header-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .intro-panel {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .intro-panel p {
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 1.08rem;
    line-height: 1.65;
    color: #f5f7fa;
  }

  @media (max-width: 700px) {
    h1,
    h2 {
      font-size: 48px;
    }

    .intro-panel p {
      font-size: 1rem;
    }
  }
</style>
