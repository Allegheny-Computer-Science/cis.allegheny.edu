  }

  .class-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  .class-name,
  .class-credits {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  .class-name {
    color: #FFFFFF;
  }

  .class-item {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    line-height: 1.4;
  }

  /* Astro scoped CSS does not target JS-injected nodes unless selectors are global. */
  :global(.updates-grid .class-item) {
    display: flex;
