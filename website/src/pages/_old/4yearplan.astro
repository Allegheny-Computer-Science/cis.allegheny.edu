CMPSC 404 - Web Applications (4)

Electives
Take eight credits from:
CMPSC 303 - Artificial Intelligence (4)
CMPSC 305 - Database Systems (4)
CMPSC 400 - Operating Systems (4)
CMPSC 403 - Computer Security (4)

Project
Take all of the following three courses (12 credits):
CMPSC 580 - Junior Seminar (4)
SE 600 - Senior Thesis I (4)
SE 610 - Senior Thesis II (4)`
    },
    Minor: {
      'Computer Science': `Foundation
Take all of the following courses (8 credits):
CMPSC 100 - Computational Expression (4)
CMPSC 102 - Discrete Structures (4)

Core
Take two of the following courses (8 credits):
CMPSC 200 - Computer Organization (4)
CMPSC 202 - Algorithm Analysis (4)
CMPSC 204 - Theoretical Machines (4)
CMPSC 406 - Internet of Things (4)

Electives
Take two of the following courses (8 credits):
CMPSC 304 - Robotic Agents (4)
CMPSC 400 - Operating Systems (4)
CMPSC 403 - Computer Security (4)`,
      'Data Science': `Foundation
Take all three of the following courses (12 credits):
CMPSC 100 - Computational Expression (4)
CMPSC 105 - Data Exploration (4)
CMPSC 301 - Data Science (4)

Core: Ethics
Take one of the following (4 credits):
PHIL 130 - Values and Knowledge (4)
PHIL 140 - Ethics and Community (4)
PHIL 210 - Oppression and Liberation (4)
POLSC 140 - Introduction to Political Theory (4)
PSYCH 162 - Human Social Behavior (4)
RELST 341 - Jewish Ethics (4)

Core: Communication
Take one of the following (4 credits):
COMM 360 - Communication Rhetoric and Civic Engagement (4)
ENGL 208 - Professional Communication (4)
ENGL 210 - Writing Creative Nonfiction (4)
FILM 375 - Documentary Tradition (4)

Core: Statistics
Take one of the following (4 credits):
BIO 385 - Biostatistics (4)
ECON 202 - Economic Statistics (4)
MATH 345 - Probability and Statistical Inference I (4)
POLSC 489 - Statistics and Data Analysis (4)
PSYCH 207 - Statistical Methods in Psychology (4)`,
      Informatics: `Foundation
Take both of the following courses (8 credits):
CMPSC 100 - Computational Expression (4)
CMPSC 101 - Data Structures (4)

Core
Take all of the following courses (8 credits):
CMPSC 350 - Computational Narrative (4)
COMM 342 - Digital Media and Technology (4)

Application Module
Take two courses from one application module (8 credits).

Humanities Informatics
PHIL 140 - Ethics and Community (4)
RELST 180 - Religion in American Life (4)
RELST 341 - Jewish Ethics (4)

Geoinformatics
At least one course must be outside CMPSC:
CMPSC 304 - Robotic Agents (4)
CMPSC 305 - Database Systems (4)
CMPSC 406 - Internet of Things (4)
ENVSC 285 - Quantitative Sustainability (4)
ENVSC 305 - Environmental GIS I (4)
ENVSC 306 - Environmental GIS II (4)

Polinformatics
COMM 256 - Power, Politics, and Communication (4)
COMM 360 - Communication Rhetoric and Civic Engagement (4)
PHIL 210 - Oppression and Liberation (4)
POLSC 120 - Comparative Government and Politics (4)
POLSC 215 - Politics in Popular Culture (4)
POLSC 318 - Politics and the Media (4)
POLSC 424 - Inequality and Social Policy (4)

Health Informatics
CMPSC 300 - Bioinformatics (4)
COMM 331 - Disease, Disability, and Difference in Popular Culture (4)
GHS 228 - Global Health Data and Visualization (4)
GHS 235 - Global Health Ethics (4)
GHS 321 - Epidemiology (4)
GHS 354 - Medical Anthropology and Perspectives of Health in Asia-Pacific (4)
HIST 380 - Disease and Medicine in Modern History (4)
PHIL 385 - Medical Ethics (4)`,
      'Software Engineering': `Foundation
Take all three of the following courses (12 credits):
CMPSC 100 - Computational Expression (4)
CMPSC 101 - Data Structures (4)
CMPSC 203 - Software Engineering (4)

Core
Take one of the following courses (4 credits):
CMPSC 201 - Programming Languages (4)
CMPSC 302 - Web Design (4)
CMPSC 404 - Web Applications (4)

Electives
Take eight credits from:
CMPSC 303 - Artificial Intelligence (4)
CMPSC 305 - Database Systems (4)
CMPSC 400 - Operating Systems (4)
CMPSC 403 - Computer Security (4)`
    }
  };

  const updateGoButtonState = () => {
    if (!(majorMinorSummary instanceof HTMLElement) || !(fieldSummary instanceof HTMLElement) || !(goButton instanceof HTMLButtonElement)) {
      return;
    }

    const hasMajorMinor = majorMinorSummary.textContent?.trim() !== defaultMajorMinorLabel;
    const hasField = fieldSummary.textContent?.trim() !== defaultFieldLabel;
    goButton.disabled = !(hasMajorMinor && hasField);
  };

  const courseLinePattern = /^(?:[A-Z]{2,}\s*\d{2,3}(?:\s+or\s+[A-Z]{2,}\s*\d{2,3})?)\b/;

  const shuffle = (array) => {
    const copy = [...array];
    for (let i = copy.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  };

  const parseSelectionCount = (instruction, courseCount) => {
    if (!instruction) return courseCount;

    const text = instruction.toLowerCase();

    if (text.includes('take all') || text.includes('take both')) return courseCount;
    if (text.includes('take one') || text.includes('choose one')) return 1;
    if (text.includes('take two') || text.includes('choose two') || text.includes('at least two') || text.includes('minimum of two')) return 2;
    if (text.includes('take eight credits')) return 2;

    return courseCount;
  };

  const toCourseItem = (line) => {
    const creditsMatch = line.match(/\((\d+)\)$/);
    return {
      text: line.replace(/\s*\((\d+)\)$/, '').trim(),
      credits: creditsMatch ? `${creditsMatch[1]} credits` : ''
    };
  };

  const parseRequirementItems = (requirementsText, selectedTrack, selectedField) => {
    const blocks = requirementsText
      .split('\n\n')
      .map((block) => block.trim())
      .filter(Boolean);

    const selectedItems = [];
    const informaticsModuleBlocks = [];
    const informaticsModuleHeadings = new Set([
      'Humanities Informatics',
      'Geoinformatics',
      'Polinformatics',
      'Health Informatics'
    ]);
    const isInformaticsProgram = selectedField === 'Informatics' && (selectedTrack === 'Major' || selectedTrack === 'Minor');

    blocks.forEach((block) => {
      const lines = block
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);

      const heading = lines[0] || '';
      const courseLines = lines.filter((line) => courseLinePattern.test(line));

      if (isInformaticsProgram && informaticsModuleHeadings.has(heading)) {
        if (courseLines.length > 0) {
          informaticsModuleBlocks.push(courseLines);
        }
        return;
      }

      const instruction = lines.find((line) => /^(take|choose)\b/i.test(line));

      if (courseLines.length === 0) return;

      const desiredCount = parseSelectionCount(instruction, courseLines.length);
      const count = Math.max(1, Math.min(desiredCount, courseLines.length));
      const chosenCourses = count >= courseLines.length ? courseLines : shuffle(courseLines).slice(0, count);

      chosenCourses.forEach((courseLine) => {
        selectedItems.push(toCourseItem(courseLine));
      });
    });

    if (isInformaticsProgram && informaticsModuleBlocks.length > 0) {
      const chosenModule = shuffle(informaticsModuleBlocks)[0];
      const chosenCourses = shuffle(chosenModule).slice(0, Math.min(2, chosenModule.length));
      chosenCourses.forEach((courseLine) => {
        selectedItems.push(toCourseItem(courseLine));
      });
    }

    return selectedItems;
  };

  const splitIntoYears = (items) => {
    const buckets = [[], [], [], []];
    const baseSize = Math.floor(items.length / 4);
    const remainder = items.length % 4;

    let offset = 0;
    for (let year = 0; year < 4; year += 1) {
      const bucketSize = baseSize + (year < remainder ? 1 : 0);
      buckets[year] = items.slice(offset, offset + bucketSize);
      offset += bucketSize;
    }

    return buckets;
  };

  const enforceCoursePlacement = (yearlyItems) => {
    const juniorSeminarPattern = /Junior Seminar/i;
    const seniorThesisPattern = /Senior Thesis I|Senior Thesis II/i;

    const juniorSeminars = [];
    const seniorThesisCourses = [];

    for (let year = 0; year < 4; year += 1) {
      const items = yearlyItems[year] || [];
      const keep = [];

      items.forEach((item) => {
        if (juniorSeminarPattern.test(item.text)) {
          juniorSeminars.push(item);
          return;
        }

        if (seniorThesisPattern.test(item.text)) {
          seniorThesisCourses.push(item);
          return;
        }

        keep.push(item);
      });

      yearlyItems[year] = keep;
    }

    if (juniorSeminars.length > 0) {
      yearlyItems[2] = [...(yearlyItems[2] || []), ...juniorSeminars];
    }

    if (seniorThesisCourses.length > 0) {
      yearlyItems[3] = [...(yearlyItems[3] || []), ...seniorThesisCourses];
    }

    return yearlyItems;
  };

  const countCredits = (items) => {
    return items.reduce((total, item) => {
      const match = item.credits.match(/(\d+)/);
      if (!match) return total;
      return total + Number(match[1]);
    }, 0);
  };

  const renderRequirementsToYearCards = () => {
    if (!(majorMinorSummary instanceof HTMLElement) || !(fieldSummary instanceof HTMLElement)) return;

    const selectedTrack = majorMinorSummary.textContent?.trim() || '';
    const selectedField = fieldSummary.textContent?.trim() || '';
    const requirementsText = programRequirements[selectedTrack]?.[selectedField];

    if (!requirementsText || yearCards.length !== 4) return;

    const items = parseRequirementItems(requirementsText, selectedTrack, selectedField);
    const totalProgramCredits = countCredits(items);
    const yearlyItems = enforceCoursePlacement(splitIntoYears(items));

    let cumulativeCredits = 0;

    yearCards.forEach((cardBody, index) => {
      const title = cardBody.querySelector('.update-card__title');
      const classList = cardBody.querySelector('.class-list');
      const summary = cardBody.querySelector('.credits-summary');

      if (!(title instanceof HTMLElement) || !(classList instanceof HTMLElement) || !(summary instanceof HTMLElement)) {
        return;
      }

      title.textContent = `YEAR ${index + 1}`;

      const cardItems = yearlyItems[index] || [];
      classList.innerHTML = cardItems
        .map((item) => {
          return `<div class="class-item"><span class="class-name">${item.text}</span><span class="class-credits">${item.credits}</span></div>`;
        })
        .join('');

      const yearCredits = countCredits(cardItems);
      cumulativeCredits += yearCredits;
      const remainingCredits = Math.max(0, totalProgramCredits - cumulativeCredits);
      summary.innerHTML = [
        `<p><strong>Total CS Credits Completed:</strong> ${cumulativeCredits}</p>`,
        `<p><strong>Credits Remaining in Major:</strong> ${remainingCredits}</p>`
      ].join('');
    });
  };

  document.querySelectorAll('.dropdown').forEach((dropdown) => {
    const summary = dropdown.querySelector('[data-dropdown-label]');
    const options = dropdown.querySelectorAll('.dropdown-option');

    options.forEach((option) => {
      option.addEventListener('click', () => {
        if (!(summary instanceof HTMLElement)) return;
        summary.textContent = option.textContent?.trim() || summary.textContent;
        dropdown.removeAttribute('open');
        updateGoButtonState();
      });
    });
  });

  if (goButton instanceof HTMLButtonElement) {
    goButton.addEventListener('click', renderRequirementsToYearCards);
  }

  updateGoButtonState();
</script>

<style>
