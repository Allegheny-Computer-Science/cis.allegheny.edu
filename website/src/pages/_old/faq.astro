---
import BaseLayout from '../../layouts/BaseLayout.astro';
const pageTitle = 'FAQ';
---

<BaseLayout pageTitle={pageTitle}>
	<div class="faq-page">
		<main>
			<section class="faq-section">
				<h1>FAQ</h1>
				<p class="faq-subtitle">Real Questions by You. Real Replies by Us.</p>

				<div class="qa-grid">
					<div class="qa-item qa-item--green">
						<p class="qa-question"><strong>Q:</strong> What majors are in Allegheny CIS?</p>
						<p class="qa-answer"><strong>A:</strong> Computer Science, Data Science, Informatics, and Software Engineering.</p>
					</div>

					<div class="qa-item qa-item--gold">
						<p class="qa-question"><strong>Q:</strong> Are there labs for all CS classes?</p>
						<p class="qa-answer"><strong>A:</strong> Most classes include hands-on lab or project-based work.</p>
					</div>

					<div class="qa-item qa-item--green">
						<p class="qa-question"><strong>Q:</strong> Can first-year students get involved in research?</p>
						<p class="qa-answer"><strong>A:</strong> Yes. Many students connect with faculty projects early through courses, advising, and programs like Cuppers.</p>
					</div>
				</div>

				<div class="faq-item">
					<h2>Ask Your Questions!</h2>
					<p>If you have questions, click the button below to open Gmail and start a new message.</p>
					<p>
						<a
							class="email-button"
							href="https://mail.google.com/mail/?view=cm&fs=1&to=cis@allegheny.edu&su=FAQ%20Question&body=Hello%2C%0A%0AI%20have%20a%20question%20about..."
							target="_blank"
							rel="noopener noreferrer"
						>
							Open Gmail Compose
						</a>
					</p>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	.faq-page {
		background-color: #1b3054;
		min-height: 100vh;
		padding: 2rem;
	}

	.faq-section {
		max-width: 1100px;
		margin: 0 auto;
	}

	h1 {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 64px;
		color: #feda48;
		margin: 0;
		line-height: 1;
	}

	.faq-subtitle {
		font-family: 'Inter', sans-serif;
		font-size: 18px;
		color: #ffffff;
		margin: 0.4rem 0 1.75rem;
	}

	.qa-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.qa-item {
		background: #ffffff;
		padding: 1rem;
		border: 2px solid;
		border-bottom-width: 20px;
		width: min(700px, 78%);
	}

	.qa-item:nth-child(odd) {
		align-self: flex-start;
	}

	.qa-item:nth-child(even) {
		align-self: flex-end;
	}

	.qa-item--green {
		border-color: #80bd41;
	}

	.qa-item--gold {
		border-color: #feda48;
	}

	.qa-question,
	.qa-answer {
		font-family: 'Inter', sans-serif;
		font-size: 16px;
		color: #1b3054;
		margin: 0;
		line-height: 1.5;
	}

	.qa-answer {
		margin-top: 0.5rem;
	}

	.faq-item {
		margin-top: 1rem;
		margin-bottom: 1rem;
		background: #f6e9a8;
		border: 2px solid #feda48;
		border-bottom-width: 20px;
		padding: 1.5rem;
	}

	h2 {
		font-family: 'Bebas Neue', sans-serif;
		font-size: 44px;
		color: #1b3054;
		margin: 0 0 0.5rem;
		line-height: 1;
	}

	.faq-item p {
		font-family: 'Inter', sans-serif;
		font-size: 16px;
		color: #1b3054;
		margin: 0 0 0.75rem;
		line-height: 1.5;
	}

	.email-button {
		display: inline-grid;
		width: fit-content;
		padding: 0.75rem 1rem;
		border: 2px solid #1b3054;
		background-color: #1b3054;
		color: #ffffff;
		font-family: 'Inter', sans-serif;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.email-button:hover {
		background-color: #ffffff;
		color: #1b3054;
	}

	@media (max-width: 900px) {
		.qa-grid {
			gap: 0.75rem;
		}

		.qa-item {
			width: 100%;
		}

		.qa-item:nth-child(odd),
		.qa-item:nth-child(even) {
			align-self: stretch;
		}

		h1 {
			font-size: 52px;
		}

		h2 {
			font-size: 36px;
		}
	}
</style>
